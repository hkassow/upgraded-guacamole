# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Copy go mod files first so the module download is cached between builds
COPY go.mod go.sum ./
RUN go mod download

# Copy source code (migrations are embedded into the binary)
COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o main .

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/main .

# served from disk at runtime by main.go
COPY index.html .
COPY static static

EXPOSE 8443

CMD ["./main"]
